{
  "name": "tutorial",
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "cz": "git-cz",
    "dev": "run-s copy-vendor generate-previews astro:dev",
    "start": "run-s copy-vendor generate-previews astro:dev",
    "build": "run-s copy-vendor generate-previews astro:build",
    "build:web": "run-s build:web:copy-vendor build:web:generate-previews astro:build",
    "build:app": "run-s copy-vendor generate-previews astro:build",
    "preview": "astro preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:ios:init": "tauri ios init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk --target aarch64",
    "astro": "astro",
    "astro:build": "astro build",
    "astro:dev": "astro dev",
    "copy-vendor": "node scripts/copy-vendor.js",
    "generate-previews": "node scripts/generate-previews.js",
    "build:web:copy-vendor": "cross-env VENDOR_MODE=cdn node scripts/copy-vendor.js",
    "build:web:generate-previews": "cross-env VENDOR_MODE=cdn node scripts/generate-previews.js",
    "icons": "node scripts/generate-icons.mjs",
    "tauri:build:all": "run-s tauri:build:prepare -p tauri:build:desktop tauri:build:mobile",
    "tauri:build:desktop": "tauri build",
    "tauri:build:mobile": "run-s build:app tauri:android:build",
    "tauri:build:prepare": "run-s tauri:android:init tauri:ios:init icons"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.4",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.2.1",
    "gsap": "^3.15.0",
    "lil-gui": "^0.21.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-custom-shader-material": "^6.4.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@tauri-apps/cli": "^2.11.0",
    "@types/three": "^0.184.0",
    "cannon-es": "^0.20.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "git-cz": "^4.9.0",
    "npm-run-all2": "^8.0.4",
    "png-to-ico": "^3.0.1",
    "semantic-release": "^25.0.3",
    "sharp": "^0.34.5",
    "stats.js": "^0.17.0"
  },
  "packageManager": "pnpm@11.1.2"
