{
  "name": "tutorial",
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "cz": "git-cz",
    "dev": "run-s copy-vendor generate-previews astro:dev",
    "start": "run-s copy-vendor generate-previews astro:dev",
    "build": "run-s copy-vendor generate-previews astro:build",
    "build:web": "run-s build:web:copy-vendor build:web:generate-previews astro:build",
    "build:app": "run-s copy-vendor generate-previews build:app:astro build:app:routes",
    "build:app:astro": "cross-env BUILD_TARGET=app astro build",
    "build:app:routes": "node scripts/prepare-app-routes.js",
    "mobile:sync": "run-s build:app && cap sync",
    "android:open": "cap open android",
    "android:run": "run-s mobile:sync android:prepare && cap run android --no-sync",
    "android:build": "run-s mobile:sync sync-version android:prepare && cap build android",
    "android:prepare": "node scripts/prepare-android.js",
    "ios:open": "cap open ios",
    "ios:run": "run-s mobile:sync && cap run ios --no-sync",
    "ios:build": "run-s mobile:sync sync-version && cap build ios",
    "preview": "astro preview",
    "astro": "astro",
    "astro:build": "astro build",
    "astro:dev": "astro dev",
    "copy-vendor": "node scripts/copy-vendor.js",
    "generate-previews": "node scripts/generate-previews.js",
    "postinstall": "node scripts/patch-csm.js",
    "build:web:copy-vendor": "cross-env VENDOR_MODE=cdn node scripts/copy-vendor.js",
    "build:web:generate-previews": "cross-env VENDOR_MODE=cdn node scripts/generate-previews.js",
    "icons": "node scripts/generate-icons.mjs",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@astrojs/vue": "^7.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/core": "^5.8.3",
    "@tresjs/leches": "^1.2.1",
    "@tresjs/post-processing": "^3.7.4",
    "astro": "^7.2.10",
    "gsap": "^3.15.0",
    "lil-gui": "^0.21.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-custom-shader-material": "^6.4.0",
    "three-stdlib": "^2.36.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@types/three": "0.186.0",
    "cannon-es": "^0.20.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "git-cz": "^4.9.0",
    "npm-run-all2": "^9.0.3",
    "png-to-ico": "^3.0.2",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "stats.js": "^0.17.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.3.1"
  }
}
