---
import fs from 'node:fs';
import path from 'node:path';
import { codeToHtml } from 'shiki';

interface Props {
  sourceFile: string;
  sceneFile?: string;
}

const { sourceFile, sceneFile } = Astro.props;

const files: { name: string; content: string }[] = [];

const mainPath = path.join(process.cwd(), 'src/components/tresjs', sourceFile);
if (fs.existsSync(mainPath)) {
  files.push({ name: sourceFile, content: fs.readFileSync(mainPath, 'utf-8') });
}

if (sceneFile) {
  const scenePath = path.join(process.cwd(), 'src/components/tresjs/scenes', sceneFile);
  if (fs.existsSync(scenePath)) {
    files.push({ name: `scenes/${sceneFile}`, content: fs.readFileSync(scenePath, 'utf-8') });
  }
}

const highlightedFiles: { name: string; html: string }[] = [];
for (const file of files) {
  const html = await codeToHtml(file.content, {
    lang: 'vue',
    theme: 'dark-plus',
  });
  highlightedFiles.push({ name: file.name, html });
}
---

<div class="lesson-preview">
  <div class="lesson-preview-frame">
    <slot />
  </div>
  <details class="lesson-code-details">
    <summary>查看源码</summary>
    <div class="lesson-code-tabs">
      {highlightedFiles.map((file) => (
        <div class="lesson-code-file">
          <div class="lesson-code-filename">{file.name}</div>
          <div class="lesson-code-content" set:html={file.html} />
        </div>
      ))}
    </div>
  </details>
</div>
